# Navan Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-navan --about` for the
# authoritative list.

# Required: OAuth client ID for the Navan OAuth app
TAP_NAVAN_CLIENT_ID=your_client_id_here

# Required: OAuth client secret for the Navan OAuth app
TAP_NAVAN_CLIENT_SECRET=your_client_secret_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_NAVAN_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://api.navan.com/v1)
TAP_NAVAN_API_URL=https://api.navan.com/v1
